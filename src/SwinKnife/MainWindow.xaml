<ui:FluentWindow x:Class="SwinKnife.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SwinKnife.Core"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="SwinKnife" Width="1420" Height="900" MinWidth="1040" MinHeight="660"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 AllowDrop="True" Icon="pack://application:,,,/SwinKnife;component/Assets/swinknife.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{l:T 'SwinKnife — il coltellino svizzero per Windows'}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/SwinKnife;component/Assets/swinknife.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="6,4,6,6">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,4,0,18">
                    <Image Source="pack://application:,,,/SwinKnife;component/Assets/swinknife.png" Width="36" Height="36" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SwinKnife" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{l:T 'il coltellino svizzero'}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="16,6" Style="{StaticResource Hint}" />
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Nav_SelectionChanged" />
            </DockPanel>

            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ContentControl x:Name="PageHost" Focusable="False" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="14,5" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <TextBlock x:Name="StatusText" Text="{l:T 'Pronto'}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</ui:FluentWindow>
