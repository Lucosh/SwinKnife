<UserControl x:Class="SwinKnife.Pages.DiskAnalyzerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SwinKnife.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SwinKnife.Controls">
    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{l:T 'Analisi disco'}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:T 'Scopri cosa occupa spazio. Clicca un riquadro della mappa per trovarlo nell\'elenco; doppio clic su una cartella per ingrandirla. Clic destro su una voce per aprirla o spostarla nel Cestino.'}" />
        </StackPanel>

        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="StopBtn" Content="{l:T 'Interrompi'}" Icon="{ui:SymbolIcon Stop24}" Visibility="Collapsed" Margin="0,0,6,0" Click="Stop_Click" />
                <ui:Button x:Name="GoBtn" Content="{l:T 'Analizza'}" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="Go_Click" />
            </StackPanel>
            <ComboBox x:Name="DriveCombo" Width="420" DisplayMemberPath="Label" />
            <ui:Button Content="{l:T 'Scegli cartella…'}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Click="Pick_Click" />
            <CheckBox x:Name="SkipCloud" Content="{l:T 'Ignora i file solo-cloud (OneDrive)'}" IsChecked="True" Margin="16,0,0,0"
                      ToolTip="{l:T 'I file non scaricati sul PC non occupano spazio su disco'}" />
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <Border x:Name="AdminBanner" Style="{StaticResource WarnBanner}" Margin="0,2,0,10" Visibility="Collapsed">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="{l:T 'Riavvia come amministratore'}" Icon="{ui:SymbolIcon Shield24}" Appearance="Primary" Click="Elevate_Click" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{l:T 'Analisi veloce: da amministratore SwinKnife legge direttamente la tabella dei file di NTFS, come WinDirStat e WizTree, e analizza un disco intero in pochi secondi invece che in minuti.'}" />
                </DockPanel>
            </Border>
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,6" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <ui:ListView x:Name="TreeList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionMode="Single" MouseDoubleClick="Tree_DoubleClick">
                <ui:ListView.View>
                    <ui:GridView>
                        <GridViewColumn Header="{l:T 'Nome'}" Width="420">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                        <TextBlock Text="{Binding Expander}" Width="18" Cursor="Hand" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" MouseLeftButtonDown="Expander_Click" />
                                        <ui:SymbolIcon Symbol="{Binding Icon}" Filled="{Binding IsDir}" FontSize="16" Margin="0,0,8,0"
                                                       Foreground="{Binding IconBrush}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{l:T 'Dimensione'}" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{l:T '% del padre'}" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="110" Height="16">
                                        <Border Background="#2C2C31" CornerRadius="3" />
                                        <Border Background="{StaticResource SwinAccentBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding BarWidth}" />
                                        <TextBlock Text="{Binding PercentText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{l:T 'File'}" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FilesText}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{l:T 'Ultima modifica'}" Width="130" DisplayMemberBinding="{Binding ModifiedText}" />
                    </ui:GridView>
                </ui:ListView.View>
                <ui:ListView.ContextMenu>
                    <ContextMenu x:Name="TreeMenu" Opened="TreeMenu_Opened" />
                </ui:ListView.ContextMenu>
            </ui:ListView>

            <ui:ListView x:Name="ExtList" Grid.Column="2" SelectionMode="Single" SelectionChanged="Ext_Changed">
                <ui:ListView.View>
                    <ui:GridView>
                        <GridViewColumn Header="{l:T 'Estensione'}" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="13" Height="13" CornerRadius="3" Background="{Binding Swatch}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Ext}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{l:T 'Dimensione'}" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="%" Width="56" DisplayMemberBinding="{Binding PercentText}" />
                        <GridViewColumn Header="{l:T 'File'}" Width="80" DisplayMemberBinding="{Binding CountText}" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>
        </Grid>

        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" Background="Transparent" />

        <DockPanel Grid.Row="5">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                <ui:Button x:Name="UpBtn" DockPanel.Dock="Left" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="{l:T 'Torna alla cartella superiore'}"
                           Style="{StaticResource IconButton}" IsEnabled="False" Click="Up_Click" />
                <TextBlock x:Name="MapLabel" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Border CornerRadius="8" ClipToBounds="True">
                <c:TreemapControl x:Name="Map" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
