<UserControl x:Class="SwinKnife.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SwinKnife.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28">
            <TextBlock Text="{l:T 'Benvenuto in SwinKnife'}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:T 'Tutti gli strumenti di cui hai bisogno, in un\'unica app. Scegli uno strumento oppure trascina un file in qualsiasi punto della finestra.'}" />

            <Border x:Name="DropArea" Style="{StaticResource DropZone}" Margin="0,22,0,22" Height="96" Cursor="Hand"
                    MouseLeftButtonUp="DropArea_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="26" Margin="0,0,14,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock VerticalAlignment="Center" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{l:T 'Trascina qui un file per aprirlo  ·  oppure fai clic per sceglierlo'}" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
