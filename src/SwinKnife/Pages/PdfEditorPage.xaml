<UserControl x:Class="SwinKnife.Pages.PdfEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SwinKnife.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SwinKnife.Controls">
    <Grid Margin="20,14,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock x:Name="TitleText" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="13" />
            <WrapPanel x:Name="DocBar" Orientation="Horizontal" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Toolbar}" Margin="0,8,0,0">
            <DockPanel>
                <ui:TextBox x:Name="FindBox" DockPanel.Dock="Right" Width="210" PlaceholderText="{l:T 'Cerca nel PDF…'}" />
                <WrapPanel x:Name="ToolBar" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="HintText" Grid.Row="2" Style="{StaticResource Hint}" Margin="4,8,0,6" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Thumbs" Background="Transparent" BorderThickness="0" AllowDrop="True" ItemContainerStyle="{StaticResource ThumbItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <Border Background="White" HorizontalAlignment="Center" BorderBrush="#40000000" BorderThickness="1">
                                <Image Source="{Binding Image}" Width="{Binding W}" Height="{Binding H}" />
                            </Border>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2">
                <Border x:Name="EmptyState" Style="{StaticResource DropZone}" AllowDrop="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="46" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,14,0,0" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{l:T 'Apri un PDF (o trascinalo qui) per modificarlo.&#10;Puoi anche aprire immagini: verranno convertite in PDF.'}" />
                    </StackPanel>
                </Border>
                <Border x:Name="PageArea" CornerRadius="8" ClipToBounds="True" Background="{StaticResource CanvasBrush}" Visibility="Collapsed">
                    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <c:PdfPageCanvas x:Name="Canvas" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <StackPanel x:Name="NavBar" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" />
    </Grid>
</UserControl>
