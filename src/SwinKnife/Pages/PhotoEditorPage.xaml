<UserControl x:Class="SwinKnife.Pages.PhotoEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SwinKnife.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:SwinKnife.Controls">
    <Grid Margin="20,14,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="158" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <ui:Button DockPanel.Dock="Left" Content="{l:T 'Apri…'}" Icon="{ui:SymbolIcon Open24}" Appearance="Primary" Click="Open_Click" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="UndoBtn" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="{l:T 'Annulla (Ctrl+Z)'}" Style="{StaticResource IconButton}" Click="Undo_Click" />
                <ui:Button x:Name="RedoBtn" Icon="{ui:SymbolIcon ArrowRedo24}" ToolTip="{l:T 'Ripristina (Ctrl+Y)'}" Style="{StaticResource IconButton}" Click="Redo_Click" />
                <ui:Button x:Name="CompareBtn" Content="{l:T 'Tieni premuto per confrontare'}" Icon="{ui:SymbolIcon Eye24}" Margin="8,0,0,0"
                           PreviewMouseLeftButtonDown="Compare_Down" PreviewMouseLeftButtonUp="Compare_Up" MouseLeave="Compare_Up" />
                <ui:Button x:Name="ResetBtn" Content="{l:T 'Ripristina originale'}" Icon="{ui:SymbolIcon ArrowReset24}" Margin="6,0,0,0" Click="Reset_Click" />
                <ui:Button x:Name="SaveBtn" Content="{l:T 'Salva copia…'}" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="6,0,0,0" Click="Save_Click" />
            </StackPanel>
            <TextBlock x:Name="NameText" Margin="14,0" VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="13"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" AllowDrop="True" x:Name="CanvasHost">
            <c:PhotoCanvas x:Name="Canvas" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6">
            <RadioButton x:Name="ModeAdjust" Content="{l:T 'Regola'}" Style="{StaticResource SegmentButton}" GroupName="mode" IsChecked="True" Checked="Mode_Checked" />
            <RadioButton x:Name="ModeFilters" Content="{l:T 'Filtri'}" Style="{StaticResource SegmentButton}" GroupName="mode" Checked="Mode_Checked" />
            <RadioButton x:Name="ModeCrop" Content="{l:T 'Ritaglia'}" Style="{StaticResource SegmentButton}" GroupName="mode" Checked="Mode_Checked" />
        </StackPanel>

        <Grid Grid.Row="3" x:Name="Panels">
            <!-- Regola -->
            <DockPanel x:Name="AdjustPanel">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock x:Name="AdjName" Width="140" TextAlignment="Right" VerticalAlignment="Center" FontSize="14" Margin="0,0,14,0" />
                    <Slider x:Name="AdjSlider" Width="460" Minimum="-100" Maximum="100" VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                    <TextBlock x:Name="AdjValue" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="14" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowReset24}" ToolTip="{l:T 'Azzera questa regolazione'}" Style="{StaticResource IconButton}" Margin="10,0,0,0" Click="ResetAdj_Click" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AdjButtons" Orientation="Horizontal" HorizontalAlignment="Center" />
                </ScrollViewer>
            </DockPanel>

            <!-- Filtri -->
            <DockPanel x:Name="FilterPanel" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="{l:T 'Intensità'}" VerticalAlignment="Center" FontSize="14" Margin="0,0,14,0" />
                    <Slider x:Name="FilterAmount" Width="360" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" IsMoveToPointEnabled="True" />
                </StackPanel>
                <ListBox x:Name="FilterList" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ThumbItem}" HorizontalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="84">
                                <Border CornerRadius="6" ClipToBounds="True" Width="76" Height="76" Background="#202024">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Ritaglia -->
            <StackPanel x:Name="CropPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <StackPanel x:Name="AspectButtons" Orientation="Horizontal" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <ui:Button Content="{l:T 'Ruota'}" Icon="{ui:SymbolIcon ArrowRotateCounterclockwise24}" Click="Rotate_Click" />
                    <ui:Button Content="{l:T 'Rifletti ↔'}" Margin="6,0,0,0" Click="FlipH_Click" />
                    <ui:Button Content="{l:T 'Rifletti ↕'}" Margin="6,0,0,0" Click="FlipV_Click" />
                    <TextBlock Text="{l:T 'Raddrizza'}" VerticalAlignment="Center" FontSize="14" Margin="24,0,12,0" />
                    <Slider x:Name="StraightenSlider" Width="300" Minimum="-45" Maximum="45" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            SmallChange="0.1" LargeChange="1" />
                    <TextBlock x:Name="StraightenLabel" Width="56" TextAlignment="Right" VerticalAlignment="Center" FontSize="14" Text="0,0°" />
                    <ui:Button Content="{l:T 'Reimposta ritaglio'}" Icon="{ui:SymbolIcon ArrowReset24}" Margin="24,0,0,0" Click="ResetCrop_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
