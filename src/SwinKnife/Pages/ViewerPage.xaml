<UserControl x:Class="SwinKnife.Pages.ViewerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SwinKnife.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <ui:Button DockPanel.Dock="Left" Content="{l:T 'Apri…'}" Icon="{ui:SymbolIcon Open24}" Appearance="Primary" Click="Open_Click" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="EditBtn" Content="{l:T 'Modifica'}" Icon="{ui:SymbolIcon Edit24}" Margin="6,0,0,0" IsEnabled="False" Click="Edit_Click" />
                <ui:Button x:Name="ConvertBtn" Content="{l:T 'Converti'}" Icon="{ui:SymbolIcon ArrowSwap24}" Margin="6,0,0,0" IsEnabled="False" Click="Convert_Click" />
                <ui:Button x:Name="GeminiBtn" Content="{l:T 'Chiedi a Gemini'}" Icon="{ui:SymbolIcon Sparkle24}" Margin="6,0,0,0" IsEnabled="False" Click="Gemini_Click" />
                <ui:Button x:Name="ExternalBtn" Content="{l:T 'App predefinita'}" Icon="{ui:SymbolIcon WindowNew24}" Margin="6,0,0,0" IsEnabled="False" Click="External_Click" />
                <ui:Button x:Name="RevealBtn" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="{l:T 'Mostra in Esplora risorse'}" Margin="6,0,0,0" IsEnabled="False" Click="Reveal_Click" />
            </StackPanel>
            <TextBlock x:Name="PathText" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource Hint}" TextWrapping="NoWrap" FontSize="13" Text="{l:T 'Nessun file aperto'}" />
        </DockPanel>

        <ProgressBar x:Name="Busy" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" Margin="0,10,0,0" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="ViewHost" Focusable="False" />
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Informazioni'}" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="InfoGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <ui:Button x:Name="HashBtn" Content="{l:T 'Calcola hash (MD5 / SHA-256)'}" HorizontalAlignment="Stretch"
                                   Margin="0,14,0,0" IsEnabled="False" Click="Hash_Click" />
                        <TextBox x:Name="HashText" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
